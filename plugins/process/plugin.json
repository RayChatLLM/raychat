{
  "id": "process",
  "version": "1.0.0",
  "sdk": 4,
  "entrypoint": "__init__:register",
  "description": "process capabilities",
  "requires": {},
  "defaults": {
    "command_output_bytes": 1536,
    "command_poll_seconds": 0.05,
    "command_read_bytes": 8192,
    "command_environment_keys": [
      "ANDROID_HOME",
      "ANDROID_SDK_ROOT",
      "APPDATA",
      "CARGO_HOME",
      "CMAKE_PREFIX_PATH",
      "COMSPEC",
      "CONDA_PREFIX",
      "DEVELOPER_DIR",
      "DOTNET_ROOT",
      "GOPATH",
      "GOROOT",
      "GRADLE_HOME",
      "HOME",
      "HOMEDRIVE",
      "HOMEPATH",
      "INCLUDE",
      "JAVA_HOME",
      "LANG",
      "LC_ALL",
      "LC_CTYPE",
      "LIB",
      "LIBPATH",
      "LOCALAPPDATA",
      "MAVEN_HOME",
      "NODE_PATH",
      "NVM_DIR",
      "PATH",
      "PATHEXT",
      "PKG_CONFIG_PATH",
      "PYENV_ROOT",
      "PYTHONPATH",
      "RUSTUP_HOME",
      "SDKROOT",
      "SYSTEMROOT",
      "TEMP",
      "TMP",
      "TMPDIR",
      "USERPROFILE",
      "VIRTUAL_ENV",
      "WINDIR"
    ]
  },
  "instructions": "Run tests or programs with {\"action\":\"run\",\"argv\":[\"python3\",\"-B\",\"-S\",\"script.py\"]}. Use argument arrays, never a shell command string. Optional cwd is workspace-relative. The host applies timeout, environment, bounded output and process cleanup policies. Inspect returncode and truncation metadata before reporting success."
}
