{
  "id": "chat_completions",
  "version": "1.0.0",
  "sdk": 4,
  "entrypoint": "__init__:register",
  "description": "chat completions capabilities",
  "requires": {},
  "defaults": {
    "user_agent": "stdlib-chat-agent/1",
    "request_options": {},
    "api_timeout_seconds": 120,
    "name": "chat_completions",
    "max_http_bytes": 2097152,
    "max_request_options_bytes": 65536,
    "max_provider_api_key_chars": 8192,
    "empty_reply_retries": 2,
    "reserved_request_options": [
      "model",
      "messages",
      "stream",
      "n",
      "tools",
      "tool_choice",
      "parallel_tool_calls",
      "functions",
      "function_call",
      "modalities",
      "audio"
    ],
    "successful_finish_reasons": [
      "stop",
      "complete",
      "completed",
      "end_turn",
      "stop_sequence",
      "eos",
      "eos_token"
    ]
  },
  "cli": [
    {
      "flags": [
        "--api-timeout"
      ],
      "type": "float",
      "setting": "api_timeout_seconds"
    },
    {
      "flags": [
        "--request-options"
      ],
      "setting": "request_options",
      "json": true,
      "environment": "LLM_REQUEST_OPTIONS"
    }
  ],
  "instructions": "Provides the configured HTTP chat model and isolated provider calls automatically. No model tool is needed to invoke it. Provider identity and authentication come only from RAYCHAT_AUTH_TOKEN, RAYCHAT_MODEL and RAYCHAT_BASE_URL. Operator launch options include --api-timeout and --request-options. Never expose provider credentials. The operator can use /models to discover model IDs; selecting one explains how to set RAYCHAT_MODEL and restart. Discovery never changes the active model."
}
